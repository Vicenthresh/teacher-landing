---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import Taskbar from '../components/Taskbar.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import BootScreen from '../components/BootScreen.astro';
import Hero from '../components/sections/Hero.astro';
import Contact from '../components/sections/Contact.astro';
import Cv from '../components/sections/Cv.astro';
import Projects from '../components/sections/Projects.astro';
import Blog from '../components/sections/Blog.astro';
import Footer from '../components/sections/Footer.astro';
import site from '../data/site.es.json';
---

<Base title={site.brand}>
  <Backdrop />
  <main id="main" class="shell">
    <Hero />
    <Contact />
    <Cv />
    <Projects />
    <Blog />
  </main>
  <Footer />
  <Taskbar idSuffix="home" nav={site.taskbar.nav} fixed>
    <ThemeSwitch slot="tray" />
  </Taskbar>
  <BootScreen mode="auto" />
</Base>

<style>
  /* section windows stack with air between them; the taskbar is fixed */
  .shell :global(.window + .window) {
    margin-top: var(--space-8);
  }
</style>
