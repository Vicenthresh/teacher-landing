---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import BootScreen from '../components/BootScreen.astro';
import site from '../data/site.es.json';
---

<Base title="Teacher Landing — Fase 0" description="Clases de inglés online y presenciales · English teacher, Chile">
  <main id="main" class="shell">
    <Window title={site.shell.windowTitle}>
      <p class="eyebrow">{site.shell.kicker}</p>
      <h1 class="chrome-text" style="font-size: clamp(1.6rem, 8vw, 2.6rem)">
        {site.shell.heading}
      </h1>
      <p class="muted">{site.shell.body}</p>
      <p class="mb-0">
        <a class="btn" href="/styleguide/">{site.shell.cta}</a>
      </p>
    </Window>
  </main>

  <BootScreen mode="auto" />
</Base>
