---
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  doc?: boolean;
}

const {
  title,
  description = 'Clases de inglés online y presenciales · English teacher, Chile',
  lang = 'es',
  bodyClass,
  doc = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/silkscreen-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={doc ? '#08121a' : '#7cc8f5'} />
  </head>
  <body class:list={[doc && 'doc', bodyClass]}>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <svg class="sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <symbol id="i-computer" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <rect x="1.6" y="2.4" width="12.8" height="8.4" rx="1" />
        <path d="M5.5 14h5M8 10.8V14" />
      </symbol>
      <symbol id="i-folder" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <path d="M1.6 4.4h4l1.4 1.8h7.4v7.4H1.6z" />
      </symbol>
      <symbol id="i-doc" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <path d="M4 1.8h5.6L12.4 4.6v9.6H4z" />
        <path d="M9.6 1.8v2.8h2.8M6 8h4.4M6 10.6h4.4" />
      </symbol>
      <symbol id="i-help" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <circle cx="8" cy="8" r="6.2" />
        <path d="M6.2 6.2a1.9 1.9 0 1 1 2.6 1.8c-.5.2-.8.7-.8 1.2v.4M8 11.8v.1" />
      </symbol>
      <symbol id="i-sound" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2.4 6.2h2.2L8 3.4v9.2L4.6 9.8H2.4z" />
        <path d="M10.4 5.8a3 3 0 0 1 0 4.4M12.3 4a5.6 5.6 0 0 1 0 8" />
      </symbol>
      <symbol id="i-globe" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <circle cx="8" cy="8" r="6.2" />
        <path d="M1.8 8h12.4M8 1.8c2.4 2.6 2.4 9.8 0 12.4M8 1.8c-2.4 2.6-2.4 9.8 0 12.4" />
      </symbol>
    </svg>

    <slot />
  </body>
</html>

<script>
  import '../scripts/desktop.js';
</script>
