---
/*
 * Old-internet garnish. One component, four small variants:
 *   glitter       inline-SVG sparkles that twinkle (aria-hidden)
 *   new-badge     blinking "NEW!" sticker, text from JSON
 *   construction  striped "en construcción" strip, text from JSON
 *   badge88       88×31-style CSS button badge, text from JSON
 *
 * Decorative variants are aria-hidden; the others carry the text they are
 * given (always from src/data/home.es.json). Everything is static under
 * prefers-reduced-motion. Colours come only from audited token pairs:
 * badge-bg/ink, card-bg/ink and btn-bg/ink.
 */
interface Props {
  variant: 'glitter' | 'new-badge' | 'construction' | 'badge88';
  text?: string;
  /** badge88 only: which audited token pair paints it */
  tone?: 'badge' | 'card' | 'btn';
  class?: string;
}

const { variant, text = '', tone = 'btn', class: className } = Astro.props;
const spark = 'M5 0 6.2 3.8 10 5 6.2 6.2 5 10 3.8 6.2 0 5 3.8 3.8z';
---

{
  variant === 'glitter' && (
    <svg
      class:list={['glitter', className]}
      viewBox="0 0 64 24"
      aria-hidden="true"
      focusable="false"
    >
      <g transform="translate(2 8) scale(1.1)"><path class="sparkle sparkle--1" d={spark} /></g>
      <g transform="translate(22 0) scale(0.8)"><path class="sparkle sparkle--2" d={spark} /></g>
      <g transform="translate(40 10) scale(1.4)"><path class="sparkle sparkle--3" d={spark} /></g>
      <g transform="translate(56 2) scale(0.7)"><path class="sparkle sparkle--4" d={spark} /></g>
    </svg>
  )
}

{variant === 'new-badge' && <span class:list={['newbadge', className]}>{text}</span>}

{
  variant === 'construction' && (
    <p class:list={['construction', className]}>
      <span class="construction__text">{text}</span>
    </p>
  )
}

{variant === 'badge88' && <span class:list={['b88', `b88--${tone}`, className]}>{text}</span>}
