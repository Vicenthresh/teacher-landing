---
interface Props {
  uid: string;
  parts?: 'all' | 'plate' | 'bubbles';
}

// Decoration only: pure CSS plate + inline SVG. No bitmaps, no requests.
const { uid, parts = 'all' } = Astro.props;
const showPlate = parts === 'all' || parts === 'plate';
const showBubbles = parts === 'all' || parts === 'bubbles';
---

{showPlate && <div class="stage__ground" aria-hidden="true"></div>}
{showPlate && <div class="stage__sun" aria-hidden="true"></div>}

{showBubbles && (
<svg
  class="bubbles"
  viewBox="0 0 800 500"
  preserveAspectRatio={parts === 'bubbles' ? 'xMidYMid meet' : 'xMidYMid slice'}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id={`orb-${uid}`} cx="34%" cy="28%" r="72%">
      <stop offset="0" style="stop-color: var(--orb-hi)"></stop>
      <stop offset="0.55" style="stop-color: var(--orb-lo)"></stop>
      <stop offset="1" style="stop-color: var(--orb-lo); stop-opacity: 0.15"></stop>
    </radialGradient>
    <radialGradient id={`rim-${uid}`} cx="36%" cy="30%" r="66%">
      <stop offset="0.7" style="stop-color: #ffffff; stop-opacity: 0"></stop>
      <stop offset="0.9" style="stop-color: #ffffff; stop-opacity: 0.55"></stop>
      <stop offset="1" style="stop-color: #ffffff; stop-opacity: 0"></stop>
    </radialGradient>
  </defs>

  <g class="bubbles__float" opacity="0.8">
    <circle cx="628" cy="104" r="58" fill={`url(#rim-${uid})`} stroke="currentColor" stroke-opacity="0.65" stroke-width="1.5"></circle>
    <ellipse cx="610" cy="84" rx="14" ry="8" fill="#ffffff" opacity="0.4" transform="rotate(-24 610 84)"></ellipse>
  </g>

  <g class="bubbles__float" opacity="0.7">
    <circle cx="712" cy="196" r="24" fill={`url(#rim-${uid})`} stroke="currentColor" stroke-opacity="0.6"></circle>
    <circle cx="536" cy="64" r="13" fill={`url(#rim-${uid})`} stroke="currentColor" stroke-opacity="0.5"></circle>
  </g>

  <g class="bubbles__float" opacity="0.6">
    <circle cx="92" cy="150" r="34" fill={`url(#rim-${uid})`} stroke="currentColor" stroke-opacity="0.55"></circle>
    <circle cx="150" cy="86" r="10" fill={`url(#rim-${uid})`} stroke="currentColor" stroke-opacity="0.45"></circle>
  </g>

  <g class="bubbles__float" opacity="0.9">
    <circle cx="120" cy="404" r="46" fill={`url(#orb-${uid})`}></circle>
    <circle cx="120" cy="404" r="46" fill="none" stroke="#ffffff" stroke-opacity="0.5"></circle>
    <ellipse cx="102" cy="384" rx="16" ry="9" fill="#ffffff" opacity="0.55" transform="rotate(-28 102 384)"></ellipse>
  </g>
</svg>
)}
