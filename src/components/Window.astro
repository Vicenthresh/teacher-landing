---
import icons from '../data/icons.json';
import site from '../data/site.es.json';

interface Props {
  title: string;
  id?: string;
  icon?:
    | 'computer'
    | 'folder'
    | 'doc'
    | 'help'
    | 'globe'
    | 'px-book'
    | 'px-envelope'
    | 'px-floppy'
    | 'px-star'
    | 'px-folder'
    | 'px-apple';
  controls?: boolean;
  drag?: boolean;
  class?: string;
  bodyClass?: string;
  /** desk window: its app key (the icon that opens it); makes it focusable and labelled by its title */
  app?: string;
  /** key in icons.json: draws that icon's 16 px atlas cell in the title bar instead of the line/pixel icon */
  atlasIcon?: keyof typeof icons;
  /** render the no-JS close link (JS removes it) and start the JS min/max/close buttons hidden */
  nojsClose?: boolean;
}

const {
  id,
  title,
  icon = 'computer',
  controls = false,
  drag = false,
  class: className,
  bodyClass,
  app,
  atlasIcon,
  nojsClose = false,
} = Astro.props;

const titleId = app && id ? `${id}-title` : undefined;
const atlasIndex = atlasIcon ? icons[atlasIcon].i : undefined;
const showControls = controls || nojsClose;

// line icons live in the sprite as #i-*, pixel-art ones as #px-*
const iconHref = icon.startsWith('px-') ? `#${icon}` : `#i-${icon}`;
---

<section
  id={id}
  class:list={['window', className]}
  data-drag={drag ? '' : undefined}
  data-app={app}
  tabindex={app ? -1 : undefined}
  aria-label={titleId ? undefined : title}
  aria-labelledby={titleId}
>
  <header class="window__bar">
    {
      atlasIndex !== undefined ? (
        <span
          class="window__icon window__icon--atlas"
          style={`--i:${atlasIndex}`}
          aria-hidden="true"
        />
      ) : (
        <svg class="window__icon" aria-hidden="true" focusable="false"><use href={iconHref} /></svg>
      )
    }
    <span class="window__title" id={titleId}>{title}</span>
    {
      showControls && (
        <span class="window__controls">
          {nojsClose && (
            <a class="winbtn" href="#main" data-nojs-close aria-label={site.window.close}>
              ×
            </a>
          )}
          <button
            class="winbtn"
            type="button"
            data-win="min"
            aria-label={site.window.min}
            hidden={nojsClose}
          >
            –
          </button>
          <button
            class="winbtn"
            type="button"
            data-win="max"
            aria-label={site.window.max}
            hidden={nojsClose}
          >
            □
          </button>
          <button
            class="winbtn"
            type="button"
            data-win="close"
            aria-label={site.window.close}
            hidden={nojsClose}
          >
            ×
          </button>
        </span>
      )
    }
  </header>
  <div class:list={['window__body', bodyClass]}>
    <slot />
  </div>
</section>
