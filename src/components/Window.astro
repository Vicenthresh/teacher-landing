---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<section class:list={['window', className]}>
  <header class="window__bar">
    <span>{title}</span>
    <span class="window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </header>
  <div class="window__body">
    <slot />
  </div>
</section>
