---
interface Props {
  title: string;
  id?: string;
  icon?:
    | 'computer'
    | 'folder'
    | 'doc'
    | 'help'
    | 'globe'
    | 'px-book'
    | 'px-envelope'
    | 'px-floppy'
    | 'px-star'
    | 'px-folder'
    | 'px-apple';
  controls?: boolean;
  drag?: boolean;
  class?: string;
  bodyClass?: string;
}

const {
  id,
  title,
  icon = 'computer',
  controls = false,
  drag = false,
  class: className,
  bodyClass,
} = Astro.props;

// line icons live in the sprite as #i-*, pixel-art ones as #px-*
const iconHref = icon.startsWith('px-') ? `#${icon}` : `#i-${icon}`;
---

<section
  id={id}
  class:list={['window', className]}
  data-drag={drag ? '' : undefined}
  aria-label={title}
>
  <header class="window__bar">
    <svg class="window__icon" aria-hidden="true" focusable="false"><use href={iconHref} /></svg>
    <span class="window__title">{title}</span>
    {
      controls && (
        <span class="window__controls">
          <button class="winbtn" type="button" data-win="min" aria-label="Minimizar ventana">
            –
          </button>
          <button class="winbtn" type="button" data-win="max" aria-label="Maximizar ventana">
            □
          </button>
          <button class="winbtn" type="button" data-win="close" aria-label="Cerrar ventana">
            ×
          </button>
        </span>
      )
    }
  </header>
  <div class:list={['window__body', bodyClass]}>
    <slot />
  </div>
</section>
