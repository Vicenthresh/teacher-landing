---
import home from '../../data/home.es.json';

const { garnish } = home;
---

<footer class="sitefoot">
  <p>{garnish.footer}</p>
</footer>

<style>
  .sitefoot {
    width: min(100% - 2rem, var(--content));
    margin-inline: auto;
    padding: var(--space-3) var(--space-3);
    color: var(--tray-ink);
    background: var(--tray-bg);
    border: 1px solid var(--tray-edge);
    border-radius: var(--radius-win);
    font-size: 0.78rem;
  }

  .sitefoot p {
    margin: 0;
  }
</style>
