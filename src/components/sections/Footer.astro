---
import Garnish from '../Garnish.astro';
import home from '../../data/home.es.json';

const { garnish } = home;
const tones = ['btn', 'card', 'badge'] as const;
---

<footer class="sitefoot">
  <div class="sitefoot__badges">
    {garnish.badges.map((text, i) => <Garnish variant="badge88" text={text} tone={tones[i % tones.length]} />)}
  </div>
  <Garnish variant="construction" text={garnish.construction} class="sitefoot__strip" />
  <p class="sitefoot__line">{garnish.footer}</p>
  <a class="sitefoot__top" href="#inicio">{garnish.backToTop}</a>
</footer>
