---
import Window from '../Window.astro';
import home from '../../data/home.es.json';

const { projects } = home;

/* the data file is teacher-editable: an unknown icon name falls back to
   the folder symbol instead of rendering an empty svg */
const ICONS = new Set(['folder', 'book', 'star', 'floppy', 'apple', 'envelope']);
const iconHref = (icon: string) => (ICONS.has(icon) ? `#px-${icon}` : '#px-folder');
---

<Window
  id={projects.id}
  title={projects.windowTitle}
  icon="px-folder"
  class="projects"
  app="proyectos"
  atlasIcon="proyectos"
  nojsClose
>
  <p class="eyebrow">{projects.listLabel}</p>
  <div class="projgrid">
    {
      projects.items.map((item) => (
        <details class="proj">
          <summary class="proj__icon">
            <svg class="px-icon" aria-hidden="true" focusable="false">
              <use href={iconHref(item.icon)} />
            </svg>
            <span class="proj__name">{item.title}</span>
          </summary>
          <div class="proj__card">
            <p class="proj__blurb">{item.blurb}</p>
            <ul class="proj__tags">
              {item.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
        </details>
      ))
    }
  </div>
</Window>
