---
import Window from '../Window.astro';
import home from '../../data/home.es.json';

const { cv } = home;
---

<Window id={cv.id} title={cv.windowTitle} icon="px-floppy" class="cv">
  <div class="cv__doc">
    <p class="cv__file mono">{cv.fileName}</p>
    <h3 class="display cv__heading">{cv.heading}</h3>
    <p class="eyebrow">{cv.timelineLabel}</p>
    <ol class="cv__timeline">
      {
        cv.timeline.map((entry) => (
          <li>
            <span class="cv__when mono">{entry.when}</span>
            <span class="cv__what">{entry.what}</span>
          </li>
        ))
      }
    </ol>
  </div>
  <p class="cluster">
    <a class="btn btn--mega" href="#" data-demo>{cv.download}</a>
  </p>
  <p class="demo-note">{cv.downloadNote}</p>
</Window>
