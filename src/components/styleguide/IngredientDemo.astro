---
import Window from '../Window.astro';
import Sky from '../Sky.astro';
import Taskbar from '../Taskbar.astro';
import Ticker from '../Ticker.astro';
import VisitorCounter from '../VisitorCounter.astro';
import BootPanel from '../BootPanel.astro';
import Backdrop from '../Backdrop.astro';
import Garnish from '../Garnish.astro';
import ThemeSwitch from '../ThemeSwitch.astro';
import home from '../../data/home.es.json';
import site from '../../data/site.es.json';
import data from '../../data/styleguide.es.json';

interface Props {
  id: string;
  nav: { label: string; href: string }[];
}

const { id, nav } = Astro.props;
const { sample, demos } = data;
const { demo: td } = data.themes;
const { garnish } = home;
const pixel = ['book', 'envelope', 'floppy', 'star', 'folder', 'apple'] as const;
---

{
  id === 'window' && (
    <div class="plinth plinth--demo">
      <Window title={`${sample.windowTitle} · ${sample.windowSub}`} controls>
        <p class="small muted mb-0">{demos.windowLine}</p>
      </Window>
    </div>
  )
}

{
  id === 'glass' && (
    <div class="plinth plinth--demo">
      <Sky uid="d-glass" parts="plate" />
      <div class="glass">
        <div class="glass__body">
          <p class="display" style="font-size:0.7rem; color: var(--glass-ink)">
            {sample.glassTitle}
          </p>
          <p class="small mb-0">{demos.glassLine}</p>
        </div>
      </div>
    </div>
  )
}

{
  id === 'button' && (
    <div class="demo-grid">
      <div class="plinth plinth--flat">
        <div class="btn-row">
          <button class="btn" type="button">
            {demos.buttonPrimary}
          </button>
          <button class="btn btn--ghost" type="button">
            {demos.buttonGhost}
          </button>
          <button class="btn" type="button" disabled>
            {demos.buttonDisabled}
          </button>
        </div>
      </div>
      <div class="plinth">
        <div class="btn-row">
          <button class="btn" type="button">
            {demos.buttonPrimary}
          </button>
        </div>
      </div>
    </div>
  )
}

{
  id === 'chrome-heading' && (
    <div class="plinth plinth--flat">
      <p class="chrome-text" style="font-size: clamp(1.7rem, 7vw, 2.8rem)">
        {demos.headingSample}
      </p>
    </div>
  )
}

{
  id === 'pixel-font' && (
    <div class="plinth plinth--flat">
      <p class="display mb-0" style="font-size: 1.25rem; line-height: 1.3">
        {demos.alphabet}
      </p>
      <p class="display mb-0" style="font-size: 0.8rem; letter-spacing: 0.1em">
        {demos.numerals}
      </p>
      <p class="display mb-0" style="font-size: 0.6rem">
        {sample.eyebrow}
      </p>
    </div>
  )
}

{
  id === 'plate' && (
    <div class="plinth plinth--tall plinth--demo">
      <Sky uid="d-plate" parts="plate" />
    </div>
  )
}

{
  id === 'bubbles' && (
    <div class="plinth plinth--tall">
      <Sky uid="d-bub" parts="bubbles" />
    </div>
  )
}

{
  id === 'taskbar' && (
    <div class="plinth plinth--desk">
      <Sky uid="d-bar" parts="plate" />
      <Taskbar idSuffix="demo" nav={nav} startOpen demo />
    </div>
  )
}

{
  id === 'drag' && (
    <div class="plinth plinth--desk plinth--drag">
      <Sky uid="d-drag" parts="plate" />
      <Window title={sample.windowTitle} drag controls class="demo-window">
        <p class="small mb-0">{demos.dragHint}</p>
      </Window>
    </div>
  )
}

{
  id === 'boot' && (
    <div class="plinth plinth--dark plinth--center">
      <BootPanel />
      <button class="btn btn--ghost" type="button" data-boot-trigger>
        {demos.bootTrigger}
      </button>
    </div>
  )
}

{
  id === 'counter' && (
    <div class="plinth plinth--dark plinth--flush">
      <div class="counter-demo">
        <VisitorCounter base={site.counter.base} demo />
      </div>
      <Ticker items={[sample.ticker]} label={site.ticker.label} />
    </div>
  )
}

{
  id === 'cursors' && (
    <div class="plinth plinth--flat">
      <div class="cursor-row">
        <button class="cursor-demo cursor-arrow" type="button">
          {demos.cursorArrow}
        </button>
        <button class="cursor-demo cursor-hand" type="button">
          {demos.cursorHand}
        </button>
        <button class="cursor-demo cursor-move" type="button">
          {demos.cursorMove}
        </button>
      </div>
    </div>
  )
}

{
  id === 'sound' && (
    <div class="plinth plinth--flat">
      <div class="btn-row">
        <button
          class="btn"
        type="button"
          data-sound
          data-on="false"
          data-label-on={site.taskbar.soundOn}
          data-label-off={site.taskbar.soundOff}
          aria-pressed="false"
          aria-label={site.taskbar.soundOff}
        >
          <svg width="17" height="17" aria-hidden="true" focusable="false">
            <use href="#i-sound" />
          </svg>
          <span class="sound-label">
            <span class="sound-label__on">{site.taskbar.soundOn}</span>
            <span class="sound-label__off">{site.taskbar.soundOff}</span>
          </span>
        </button>
      </div>
    </div>
  )
}

{
  id === 'koi' && (
    <div class="plinth plinth--tall plinth--bd sg-nodots" data-skin="aero">
      <Backdrop uid="sg-koi" contained />
    </div>
  )
}

{
  id === 'dotmatrix' && (
    <div class="plinth plinth--tall plinth--bd plinth--water" data-skin="aero">
      <span class="dotmatrix" aria-hidden="true" />
      <p class="small sg-onwater">{td.dotsLine}</p>
    </div>
  )
}

{
  id === 'xp-hill' && (
    <div class="plinth plinth--tall plinth--bd" data-skin="xp">
      <Backdrop uid="sg-xp" contained still />
    </div>
  )
}

{
  id === 's90-tiles' && (
    <div class="plinth plinth--tall plinth--bd" data-skin="90s">
      <Backdrop uid="sg-90" contained still />
    </div>
  )
}

{
  (id === 'xp-chrome' || id === 's90-chrome') && (
    <div class="plinth plinth--tall plinth--bd" data-skin={id === 'xp-chrome' ? 'xp' : '90s'}>
      <Backdrop uid={`sg-${id}`} contained still />
      <Window title={td.windowTitle} controls class="demo-window">
        <p class="small mb-0">{td.windowLine}</p>
      </Window>
    </div>
  )
}

{
  id === 'glitter' && (
    <div class="plinth plinth--flat plinth--center">
      <Garnish variant="glitter" class="glitter--lg" />
    </div>
  )
}

{
  id === 'new-badge' && (
    <div class="plinth plinth--flat plinth--center">
      <Garnish variant="new-badge" text={garnish.newBadge} />
    </div>
  )
}

{
  id === 'construction' && (
    <div class="plinth plinth--flat">
      <Garnish variant="construction" text={garnish.construction} />
    </div>
  )
}

{
  id === 'badge88' && (
    <div class="plinth plinth--flat">
      <div class="cluster">
        <Garnish variant="badge88" tone="btn" text={garnish.badges[0]} />
        <Garnish variant="badge88" tone="badge" text={garnish.badges[1]} />
        <Garnish variant="badge88" tone="card" text={garnish.badges[2]} />
      </div>
    </div>
  )
}

{
  id === 'pixel-set' && (
    <div class="plinth plinth--flat">
      <ul class="pixel-row">
        {
          pixel.map((name) => (
            <li>
              <svg class="px-icon" aria-hidden="true" focusable="false">
                <use href={`#px-${name}`} />
              </svg>
              <span class="small">{td.pixelLabels[name] ?? name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  )
}

{
  id === 'mega' && (
    <div class="demo-grid demo-grid--3">
      {
        (['aero', 'xp', '90s'] as const).map((skin) => (
          <div class="plinth plinth--flat plinth--center" data-skin={skin}>
            <button class="btn btn--mega" type="button">
              {td.megaLabel}
            </button>
          </div>
        ))
      }
    </div>
  )
}

{
  id === 'theme-switch' && (
    <div class="plinth plinth--desk plinth--bd" id="sw-demo" data-skin="aero">
      <Backdrop uid="sg-sw" contained still />
      <Window title={td.windowTitle} class="demo-window sg-sw__window">
        <p class="small mb-0">{td.swapLine}</p>
      </Window>
      <div class="taskbar sg-sw__bar">
        <ThemeSwitch controls="sw-demo" extra={[{ id: 'y2k', label: 'Y2K' }]} />
      </div>
    </div>
  )
}
